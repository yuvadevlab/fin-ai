{
  "name": "@finai/prompts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Centralized, type-safe prompt constants, system instructions, and dynamic prompt builders for FinAI",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@finai/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2"
  }
}
