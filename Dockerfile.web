# ==============================================================================
# FinAI Web Frontend — Production Dockerfile
# Optimized for Google Cloud Run, Render, Koyeb, and self-hosted Docker
# Author: yuva.devlab@gmail.com
# ==============================================================================

FROM node:24-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

# ─── Stage 1: Dependencies ───────────────────────────────────────────────────
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json ./

COPY packages/database/package.json ./packages/database/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/prompts/package.json ./packages/prompts/
COPY packages/validation/package.json ./packages/validation/
COPY packages/finance-engine/package.json ./packages/finance-engine/
COPY packages/ai-engine/package.json ./packages/ai-engine/
COPY packages/ui/package.json ./packages/ui/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

RUN pnpm install --frozen-lockfile

# ─── Stage 2: Builder ─────────────────────────────────────────────────────────
FROM base AS builder
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY --from=deps /app ./
COPY packages ./packages
COPY apps/web ./apps/web

# Generate Prisma client and build packages
RUN pnpm db:generate
RUN pnpm --filter @fin-ai/web... build

# ─── Stage 3: Runner ──────────────────────────────────────────────────────────
FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME="0.0.0.0"

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy standalone bundle and static assets
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder /app/apps/web/public ./fin-ai/apps/web/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./fin-ai/apps/web/.next/static

USER nextjs

EXPOSE 3001

# Run Next.js standalone server
CMD ["sh", "-c", "if [ -f fin-ai/apps/web/server.js ]; then node fin-ai/apps/web/server.js; else node apps/web/server.js; fi"]
