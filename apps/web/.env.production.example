# ==============================================================================
# FinAI Web Frontend — Production Environment Template
# Author: yuva.devlab@gmail.com
# ==============================================================================

# ─── Server Configuration ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── Backend API Endpoint ────────────────────────────────────────────────────
# Public HTTPS URL of the deployed FinAI Backend API
NEXT_PUBLIC_API_URL=https://finai-api.yourdomain.com

# ─── DevLab Portal & Single Sign-On ──────────────────────────────────────────
# Public HTTPS URL of the deployed DevLab Portal Web UI
NEXT_PUBLIC_DEVLAB_PORTAL_WEB_URL=https://portal.yourdomain.com

# Public HTTPS URL of the deployed DevLab Portal API
NEXT_PUBLIC_DEVLAB_PORTAL_API_URL=https://portal-api.yourdomain.com

# Application ID in DevLab catalog
NEXT_PUBLIC_APP_ID=finai

# ─── Feature Flags ───────────────────────────────────────────────────────────
NEXT_PUBLIC_PAGE_SETTINGS=true
NEXT_PUBLIC_PAGE_AI_ADVISOR=true
NEXT_PUBLIC_FEATURE_ACCOUNTS=true
NEXT_PUBLIC_FEATURE_AI_ADVISOR=true
NEXT_PUBLIC_FEATURE_AI_INSIGHT=true
NEXT_PUBLIC_FEATURE_BUDGETS=true
NEXT_PUBLIC_FEATURE_FAMILY=true
NEXT_PUBLIC_FEATURE_GOALS=true
NEXT_PUBLIC_FEATURE_HEALTH=true
NEXT_PUBLIC_FEATURE_INVESTMENTS=true
NEXT_PUBLIC_FEATURE_NOTIFICATIONS=true
NEXT_PUBLIC_FEATURE_REPORTS=true
NEXT_PUBLIC_FEATURE_SEARCH=true
NEXT_PUBLIC_FEATURE_SETTINGS=true
NEXT_PUBLIC_FEATURE_TRANSACTIONS=true
