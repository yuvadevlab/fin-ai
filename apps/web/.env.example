# ==============================================================================
# FinAI Web Frontend Environment Template (apps/web/.env.example)
# Copy this file to `apps/web/.env.local` for local development.
# ==============================================================================

# ─── API & Backend Endpoints ─────────────────────────────────────────────────
# Base HTTP URL for the FinAI NestJS backend API.
# Defaults to http://localhost:4000 (endpoints are prefixed with /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── DevLab Portal & Authentication ──────────────────────────────────────────
# Portal Web UI URL (for login redirects)
NEXT_PUBLIC_DEVLAB_PORTAL_WEB_URL="http://localhost:3005"

# Portal API URL (for token verification / OIDC)
NEXT_PUBLIC_DEVLAB_PORTAL_API_URL="http://localhost:3015"

# Application identifier used for DevLab workspace registration and telemetry.
# Defaults to "finai".
NEXT_PUBLIC_APP_ID=finai

# ─── Page Navigation Flags ───────────────────────────────────────────────────
# Controls top-level page access and route activation.
# Values: "true" | "false"
NEXT_PUBLIC_PAGE_SETTINGS=true
NEXT_PUBLIC_PAGE_AI_ADVISOR=true

# ─── Feature Flags ───────────────────────────────────────────────────────────
# Controls client-side feature visibility and runtime activation.
# Values: "true" | "false"
NEXT_PUBLIC_FEATURE_ACCOUNTS=true
NEXT_PUBLIC_FEATURE_AI_ADVISOR=true
NEXT_PUBLIC_FEATURE_AI_INSIGHT=true
NEXT_PUBLIC_FEATURE_BUDGETS=true
NEXT_PUBLIC_FEATURE_FAMILY=true
NEXT_PUBLIC_FEATURE_GOALS=true
NEXT_PUBLIC_FEATURE_HEALTH=true
NEXT_PUBLIC_FEATURE_INVESTMENTS=true
NEXT_PUBLIC_FEATURE_NOTIFICATIONS=true
NEXT_PUBLIC_FEATURE_REPORTS=true
NEXT_PUBLIC_FEATURE_SEARCH=true
NEXT_PUBLIC_FEATURE_SETTINGS=true
NEXT_PUBLIC_FEATURE_TRANSACTIONS=true

# ─── Settings Section Toggles ─────────────────────────────────────────────────
# Controls visibility of specific tabs within the Settings page (/settings).
# Values: "true" | "false"
NEXT_PUBLIC_SETTING_PROFILE=true
NEXT_PUBLIC_SETTING_WORKSPACE=false
NEXT_PUBLIC_SETTING_MEMBERS=false
NEXT_PUBLIC_SETTING_NOTIFICATIONS=false
NEXT_PUBLIC_SETTING_CATEGORIES=false
NEXT_PUBLIC_SETTING_ACCOUNTS=false
NEXT_PUBLIC_SETTING_SECURITY=false
NEXT_PUBLIC_SETTING_APPEARANCE=true
NEXT_PUBLIC_SETTING_MIGRATION=true
