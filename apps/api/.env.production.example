# ==============================================================================
# FinAI Backend API — Production Environment Template
# Author: yuva.devlab@gmail.com
# ==============================================================================

# ─── Server Configuration ────────────────────────────────────────────────────
PORT=4001
NODE_ENV=production

# ─── Canonical Frontend URL & CORS ───────────────────────────────────────────
WEB_URL=https://finai.yourdomain.com

# ─── Database Connection ─────────────────────────────────────────────────────
# PostgreSQL connection string with pgvector enabled
DATABASE_URL=postgresql://finai_user:YourSecurePassword@host:5432/finai?sslmode=require

# ─── Security & Authentication ───────────────────────────────────────────────
JWT_SECRET=replace_with_a_secure_random_64_character_hex_or_uuid_string
JWT_EXPIRY=7d

# DevLab Portal Authority Endpoints (for SSO & JWKS token verification)
DEVLAB_PORTAL_API_URL=https://portal-api.yourdomain.com
DEVLAB_API_KEY=

# ─── AI Engine Configuration ─────────────────────────────────────────────────
# Supported providers: google-ai-studio | openrouter | groq | ollama
AI_PROVIDER=google-ai-studio

# Google AI Studio Configuration
GOOGLE_AI_STUDIO_BASE_URL=https://generativelanguage.googleapis.com
GOOGLE_AI_STUDIO_API_PATH=/v1beta/openai/chat/completions
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here
GOOGLE_AI_STUDIO_MODEL=gemini-3.5-flash-lite

# OpenRouter Configuration (if AI_PROVIDER=openrouter)
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# OPENROUTER_API_PATH=/v1/chat/completions
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Groq Configuration (if AI_PROVIDER=groq)
# GROQ_BASE_URL=https://api.groq.com
# GROQ_API_PATH=/openai/v1/chat/completions
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# ─── Application Logging ─────────────────────────────────────────────────────
LOG_ENABLED=true
LOG_LEVEL=info
LOG_REQUESTS=true
LOG_PERSIST=false
