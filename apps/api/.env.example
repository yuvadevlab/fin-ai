# ==============================================================================
# FinAI Backend API Local Environment Template (apps/api/.env.example)
# ==============================================================================

# Database Connection
DATABASE_URL=postgresql://finai_admin:FinAiSecurePass2026!@localhost:5432/finai?schema=public

# Authentication
JWT_SECRET=SuperSecretProductionJwtKey2026FinAi!
JWT_EXPIRY=7d

# ─── AI Provider Selection ───────────────────────────────────────────────────
# Active LLM provider: ollama | openrouter | groq | google-ai-studio
# Only the selected provider's credentials are used at runtime.
AI_PROVIDER=ollama

# NOTE: There are NO hardcoded endpoints in code — every provider REQUIRES
# its {PROVIDER}_BASE_URL and {PROVIDER}_API_PATH env vars (see sections below).

# Local AI Engine (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_PATH=/api/chat
OLLAMA_MODEL=qwen3:8b

# OpenRouter — FREE models only (https://openrouter.ai/models?max_price=0)
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_API_PATH=/v1/chat/completions
OPENROUTER_API_KEY=
# Finance-tuned free: inclusionai/ling-3.0-flash-fin:free
# Other free w/ tool calling: nvidia/nemotron-3-ultra-550b-a55b:free | thinkingmachines/inkling:free
OPENROUTER_MODEL=

# Groq — free developer tier (https://console.groq.com/keys)
GROQ_BASE_URL=https://api.groq.com
GROQ_API_PATH=/openai/v1/chat/completions
GROQ_API_KEY=
# Free production slugs: openai/gpt-oss-120b | openai/gpt-oss-20b | llama-3.3-70b-versatile
GROQ_MODEL=

# Google AI Studio — free tier (https://aistudio.google.com/apikey)
GOOGLE_AI_STUDIO_BASE_URL=https://generativelanguage.googleapis.com
GOOGLE_AI_STUDIO_API_PATH=/v1beta/openai/chat/completions
GOOGLE_AI_STUDIO_API_KEY=
# Free-tier stable slugs: gemini-3.8-flash | gemini-3.7-flash | gemini-3.6-flash
GOOGLE_AI_STUDIO_MODEL=

# Server Ports & Origins
PORT=4000
WEB_URL=http://localhost:3000
API_CORS_ORIGIN=http://localhost:3000

# ─── Application Logging ─────────────────────────────────────────────────────
# Master switch: when "false", all application + request loggers become no-ops.
# Defaults to "true" when unset. Useful to silence the console in production.
LOG_ENABLED=true

# Minimum log level emitted to console (and to the log file, when persistence
# is on). Messages below this threshold are dropped silently.
#   debug | info | warn | error
# Defaults to "info" when unset. Set to "debug" for verbose local debugging.
LOG_LEVEL=info

# Request-logger middleware: when "true", logs every HTTP request after the
# response finishes (method, url, status, duration, and request-id). When
# "false", the request logger is not mounted. Defaults to "true".
LOG_REQUESTS=true

# When "true", log output is ALSO appended (UTF-8) to the file path given by
# LOG_FILE, in addition to console output. When "false" or unset, persistence
# is a no-op even if LOG_FILE is set. Defaults to "false".
LOG_PERSIST=false

# Target path for the persisted log file. Only used when LOG_PERSIST=true.
# The parent directory is created automatically on first write.
#   e.g. /var/log/finai/api.log   (requires write permission on that path)
#   e.g. ./logs/api.log           (relative to the cwd where the API starts)
LOG_FILE=
