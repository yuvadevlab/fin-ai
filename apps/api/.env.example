# ==============================================================================
# FinAI Backend API Local Environment Template (apps/api/.env.example)
# Copy this file to `apps/api/.env` for local development.
# ==============================================================================

# ─── Database Connection ─────────────────────────────────────────────────────
# PostgreSQL connection string for Prisma ORM.
DATABASE_URL=postgresql://finai_admin:FinAiSecurePass2026!@localhost:5432/finai?schema=public

# ─── Authentication & Security ───────────────────────────────────────────────
# Secret key used for signing and verifying JSON Web Tokens (JWT).
JWT_SECRET=SuperSecretProductionJwtKey2026FinAi!
# Token validity duration before re-authentication is required.
JWT_EXPIRY=7d

# DevLab Portal API URL for token verification & JWKS lookups
DEVLAB_PORTAL_API_URL="http://localhost:3015"
# DevLab M2M API Key
DEVLAB_API_KEY=

# ─── Server Port & Frontend Origin ───────────────────────────────────────────
# HTTP port for the NestJS API server. Defaults to 4000.
PORT=4000

# Canonical Web frontend URL.
# Single variable used for CORS origin whitelisting, password reset links, and emails.
# Accepts a single origin or comma-separated origins for multi-device testing:
# e.g., WEB_URL=http://localhost:3000,http://192.168.1.6:3000
WEB_URL=http://localhost:3000

# ─── AI Provider Selection ───────────────────────────────────────────────────
# Active LLM provider: ollama | openrouter | groq | google-ai-studio
# Only the selected provider's credentials are used at runtime.
AI_PROVIDER=ollama

# Optional role-specific provider overrides:
# AI_PROVIDER_AGENT=ollama
# AI_PROVIDER_CHAT=groq

# NOTE: There are NO hardcoded endpoints in code — every provider REQUIRES
# its {PROVIDER}_BASE_URL and {PROVIDER}_API_PATH env vars (see sections below).

# ─── Local AI Engine (Ollama) ────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_PATH=/api/chat
OLLAMA_MODEL=gemma4:31b-cloud

# ─── OpenRouter (Free Models) ────────────────────────────────────────────────
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_API_PATH=/v1/chat/completions
OPENROUTER_API_KEY=
# Finance-tuned free: inclusionai/ling-3.0-flash-fin:free
OPENROUTER_MODEL=

# ─── Groq (Free Tier) ────────────────────────────────────────────────────────
GROQ_BASE_URL=https://api.groq.com
GROQ_API_PATH=/openai/v1/chat/completions
GROQ_API_KEY=
# Free production slugs: qwen/qwen3.8-27b | llama-3.3-70b-versatile
GROQ_MODEL=

# ─── Google AI Studio (Free Tier) ────────────────────────────────────────────
GOOGLE_AI_STUDIO_BASE_URL=https://generativelanguage.googleapis.com
GOOGLE_AI_STUDIO_API_PATH=/v1beta/openai/chat/completions
GOOGLE_AI_STUDIO_API_KEY=
# Free-tier stable slugs: gemini-3.8-flash | gemini-3.7-flash
GOOGLE_AI_STUDIO_MODEL=

# ─── Application Logging ─────────────────────────────────────────────────────
# Master switch: when "false", all application + request loggers become no-ops.
# Defaults to "true" when unset. Useful to silence the console in production.
LOG_ENABLED=true

# Minimum log level emitted to console (and to the log file, when persistence is on).
# Values: debug | info | warn | error
LOG_LEVEL=info

# Request-logger middleware: when "true", logs every HTTP request after response finishes.
LOG_REQUESTS=true

# When "true", log output is ALSO appended (UTF-8) to the file path given by LOG_FILE.
LOG_PERSIST=false

# Target path for the persisted log file. Only used when LOG_PERSIST=true.
# e.g. /var/log/finai/api.log or ./logs/api.log
LOG_FILE=
