# ==============================================================================
# FinAI Production Environment Configuration (.env)
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_USER=finai_admin
POSTGRES_PASSWORD=FinAiSecurePass2026!
POSTGRES_DB=finai_db
DATABASE_URL=postgresql://finai_admin:FinAiSecurePass2026!@postgres:5432/finai_db?schema=public

# Application Ports
PORT=4000
API_PORT=4000

# Security & Authentication
JWT_SECRET=SuperSecretProductionJwtKey2026FinAi!
JWT_EXPIRY=7d

# Ollama AI Advisor Configuration
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b

# Frontend & CORS Settings (Update with your domain or IP configured in Nginx Proxy Manager)
WEB_URL=http://localhost
API_CORS_ORIGIN=http://localhost
NEXT_PUBLIC_API_URL=http://localhost/api

# Feature Flags
NEXT_PUBLIC_PAGE_SETTINGS=true
NEXT_PUBLIC_PAGE_AI_ADVISOR=true
NEXT_PUBLIC_FEATURE_ACCOUNTS=true
NEXT_PUBLIC_FEATURE_AI_ADVISOR=true
NEXT_PUBLIC_FEATURE_AI_INSIGHT=true
NEXT_PUBLIC_FEATURE_BUDGETS=true
NEXT_PUBLIC_FEATURE_FAMILY=true
NEXT_PUBLIC_FEATURE_GOALS=true
NEXT_PUBLIC_FEATURE_HEALTH=true
NEXT_PUBLIC_FEATURE_INVESTMENTS=true
NEXT_PUBLIC_FEATURE_NOTIFICATIONS=true
NEXT_PUBLIC_FEATURE_REPORTS=true
NEXT_PUBLIC_FEATURE_SEARCH=true
NEXT_PUBLIC_FEATURE_SETTINGS=true
NEXT_PUBLIC_FEATURE_TRANSACTIONS=true
